# GEMINI_API_KEY: Gemini AI API 调用所需的密钥。
# AI Studio 会在运行时自动从用户密钥中注入。
# 用户通过 AI Studio UI 中的 Secrets 面板配置。
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: 应用程序托管的 URL。
# AI Studio 会在运行时使用 Cloud Run 服务 URL 自动注入。
# 用于自引用链接、OAuth 回调和 API 端点。
APP_URL="MY_APP_URL"

# IMG_BED_URL: 图床服务的 URL。
# 用于上传和管理图片。
IMG_BED_URL="https://img.072199.xyz"

# IMG_BED_TOKEN: 图床服务的 API 令牌。
# 用于上传图片时的身份验证。
IMG_BED_TOKEN="YOUR_IMG_BED_TOKEN"
